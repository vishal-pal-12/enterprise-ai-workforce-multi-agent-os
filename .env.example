# ==============================================================================
# Enterprise AI Workforce — Multi-Agent OS Environment Configuration Template
# ==============================================================================

# Relational Database Configuration
# Default: Local SQLite database
DATABASE_URL=sqlite:///./enterprise_agent.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/enterprise_agent_db

# LLM Provider Configuration
# Set GOOGLE_API_KEY (Gemini) or OPENAI_API_KEY
GOOGLE_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Executive Email Gateway & SMTP Relay (Optional for live delivery)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=sales-intelligence@enterprise.internal

# Server Network Configuration
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
